# Copy to .env and fill in. Never commit .env.

# --- LLM (optional) ---------------------------------------------------------
# Without a key the service runs in search-only mode (no generated answers).
# Any LangChain chat provider works; install its package, e.g.:
#   google_genai -> pip install langchain-google-genai   (default)
#   anthropic    -> pip install langchain-anthropic
#   openai       -> pip install langchain-openai
TAKAM_LLM_PROVIDER=google_genai
TAKAM_LLM_MODEL=gemini-3.5-flash
# Lighter model of the same provider, tried when the primary fails (overload/timeout). Empty disables.
TAKAM_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
TAKAM_LLM_API_KEY=
# Set to false to force search-only mode even when a key is present.
TAKAM_LLM_ENABLED=true
TAKAM_LLM_TIMEOUT=25

# --- Source site (used only by `takam-ingest fetch`) -----------------------
TAKAM_BASE_URL=https://takam.mof.gov.il/
TAKAM_CHAPTERS=[1]
TAKAM_REQUEST_DELAY=0.5
TAKAM_REQUEST_TIMEOUT=60
TAKAM_MAX_RETRIES=3

# --- Retrieval ---------------------------------------------------------------
TAKAM_SEARCH_TOP_K=8

# Where raw data and the index live (defaults to ./data in the project root).
# TAKAM_DATA_DIR=./data
